<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>SoS-Trainer</AssemblyName>
    <Version>0.1.0</Version>
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <DebugType>none</DebugType>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <LibDebugPath Condition="'$(LibDebugPath)' == ''">$(MSBuildProjectDirectory)\libdebug.dll</LibDebugPath>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="libdebug"><HintPath>$(LibDebugPath)</HintPath><Private>true</Private></Reference>
    <EmbeddedResource Include="*-hook.bin;*-hook.json;LICENSE.txt;CREDITS.txt" />
  </ItemGroup>
</Project>
