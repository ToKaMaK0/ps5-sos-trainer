+#include "cheats_session.h"
+#include <string.h>
+void cheats_session_select(cheats_session_t *state, int pid, const char *title) {
+    if (pid <= 0 || !title || !title[0]) { memset(state, 0, sizeof *state); return; }
+    if (state->pid == pid && strcmp(state->title, title) == 0) return;
+    memset(state, 0, sizeof *state);
+    state->pid = pid;
+    size_t n = strlen(title);
+    if (n >= sizeof state->title) { state->pid = 0; return; }
+    memcpy(state->title, title, n + 1);
+}
+int cheats_session_has(const cheats_session_t *state, int flat) {
+    return flat >= 0 && flat < CHEATS_SESSION_MODS &&
+           (int)((state->bits[flat >> 6] >> (flat & 63)) & 1);
+}
+int cheats_session_set(cheats_session_t *state, int flat, int on) {
+    if (state->pid <= 0 || flat < 0 || flat >= CHEATS_SESSION_MODS) return -1;
+    uint64_t mask = UINT64_C(1) << (flat & 63);
+    if (on) state->bits[flat >> 6] |= mask;
+    else state->bits[flat >> 6] &= ~mask;
+    return 0;
+}
